# Independent management database; create this empty database before starting.
DATAAGENT_DATABASE_URL=mysql+pymysql://dataagent:CHANGE_ME@127.0.0.1:3306/dataagent_python?charset=utf8mb4
DATAAGENT_REDIS_URL=redis://127.0.0.1:6379/0
DATAAGENT_DATA_DIR=data
DATAAGENT_MODEL_TIMEOUT=30
# 0 disables dimension checking, matching the Java default; set before indexing.
DATAAGENT_EMBEDDING_DIMENSION=0
# local | elasticsearch | milvus. Rebuild knowledge after switching destinations.
DATAAGENT_VECTOR_BACKEND=local
DATAAGENT_VECTOR_URL=
DATAAGENT_VECTOR_NAMESPACE=dataagent
# Optional Bearer credential. URLs must not include credentials or query strings.
DATAAGENT_VECTOR_TOKEN=
# DOC parsing only: run uv run python tools/install_doc_parser.py; Java 17+ is required.
# Defaults to DATAAGENT_DATA_DIR/tools/tika-app-3.3.3.jar; other formats use Python parsers.
# DATAAGENT_TIKA_APP_JAR=D:/path/to/tika-app-3.3.3.jar
DATAAGENT_MAX_UPLOAD_BYTES=20971520
DATAAGENT_MAX_AVATAR_BYTES=5242880
DATAAGENT_MAX_DOCUMENT_CHARS=1000000
DATAAGENT_CORS_ORIGINS=["http://localhost:3000","http://127.0.0.1:3000"]

# Optional real-provider acceptance; never committed. Base URL excludes /v1
# when using the default paths. Custom paths are relative to the base URL.
OPENAI_BASE_URL=
LLM_MODEL=gpt-6.1-sol
OPENAI_API_KEY=
EMBEDDING_BASE_URL=
EMBEDDING_MODEL=
EMBEDDING_API_KEY=
